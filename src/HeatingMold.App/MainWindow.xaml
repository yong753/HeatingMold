<Window x:Class="HeatingMold.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HeatingMold.App"
        Title="HeatingMold"
        Height="820" Width="1320" MinWidth="1080" MinHeight="680"
        Left="40" Top="40" WindowStartupLocation="Manual"
        Background="#F3F4F6" FontFamily="Malgun Gothic, Segoe UI" FontSize="12" Foreground="#1F2328">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E1E4E8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2328"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B636D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="CardBody" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
        </Style>
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E7EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- 사이드바 탭 머리글: 좁은 폭(300~420px)에서 5개 탭이 한 줄에 들어가되,
             선택된 탭이 버튼처럼 분명히 보이도록 세그먼트형 칩으로 그린다. -->
        <Style x:Key="SidebarTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{StaticResource LineBrush}" Background="#EEF1F5"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HeatingMold" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="OpenButton" Content="STEP 열기…" Click="Open_Click"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="StandardViewButton" Content="표준 뷰 ▾" Click="StandardViewMenu_Click"
                            Style="{StaticResource FlatButton}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="정면 (−Z)" Tag="Front" Click="StandardView_Click"/>
                                <MenuItem Header="후면 (+Z)" Tag="Back" Click="StandardView_Click"/>
                                <MenuItem Header="위쪽 (−Y)" Tag="Top" Click="StandardView_Click"/>
                                <MenuItem Header="아래쪽 (+Y)" Tag="Bottom" Click="StandardView_Click"/>
                                <MenuItem Header="좌측 (−X)" Tag="Left" Click="StandardView_Click"/>
                                <MenuItem Header="우측 (+X)" Tag="Right" Click="StandardView_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                   BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,2">
            <StatusBarItem>
                <TextBlock x:Name="HoverText" Text="" MinWidth="170" Foreground="#0A6A2F"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="준비"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="340" MinWidth="300" MaxWidth="420"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="VertexEditModeBox" Content="발열경로 편집"
                                      VerticalAlignment="Center"
                                      Checked="VertexEditMode_Changed" Unchecked="VertexEditMode_Changed"/>
                            <Button x:Name="VertexUndoButton" Content="경로 Undo"
                                    Click="VertexUndo_Click" Style="{StaticResource CompactButton}"
                                    Margin="10,0,4,0" VerticalAlignment="Center"/>
                            <Button x:Name="VertexRedoButton" Content="경로 Redo"
                                    Click="VertexRedo_Click" Style="{StaticResource CompactButton}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="작업 정면에서 발열경로의 꼭지점을 드래그해 수정합니다. 편집 후 패턴을 다시 생성하면 편집 내용은 사라집니다."
                                       Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="ExcludeModeBox" Content="영역 제외"
                                      VerticalAlignment="Center" IsEnabled="False"
                                      Checked="ExcludeMode_Changed" Unchecked="ExcludeMode_Changed"/>
                            <Button x:Name="ClearExclusionsButton" Content="제외 초기화"
                                    Click="ClearExclusions_Click" Style="{StaticResource CompactButton}"
                                    Margin="10,0,4,0" VerticalAlignment="Center" IsEnabled="False"/>
                            <TextBlock Text="활성 작업영역 평면에서 드래그해 제외영역을 그립니다. Esc로 진행 중인 드래그를 취소합니다."
                                       Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <local:OccViewport x:Name="Viewport" Grid.Row="1"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource LineBrush}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <Border Grid.Column="2" Background="#F7F8FA"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 공통: 작업 방향 -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="14,12,14,0">
                        <StackPanel>
                            <TextBlock Text="작업 방향" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="WorkingSideText" Text="작업 방향 · 모델을 불러오세요"
                                       Style="{StaticResource Hint}" Margin="0,4,0,8"/>
                            <Button Content="작업 정면으로 돌아가기" Click="WorkingFront_Click"
                                    Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </Border>

                    <TabControl x:Name="SidebarTabs" Grid.Row="1" Margin="10,10,6,0"
                                Background="Transparent" BorderThickness="0"
                                SelectionChanged="SidebarTabs_SelectionChanged">
                        <!-- 1. 작업 영역 -->
                        <TabItem Header="영역" Style="{StaticResource SidebarTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="4,8,10,12">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="뷰포트에서 Face를 클릭하거나 Ctrl+클릭으로 추가/제외, Shift+드래그로 여러 Face를 선택합니다. Enter로 새 작업영역이 추가됩니다."/>
                                        <ListBox x:Name="SelectedFacesList" MinHeight="70" MaxHeight="130" Margin="0,8,0,6"
                                                 BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                                        <TextBlock x:Name="SelectionSummaryText" Text="Face를 선택하세요"
                                                   Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                        <Button x:Name="ConfirmAreaButton" Content="영역 추가 (Enter)"
                                                Click="ConfirmArea_Click" Style="{StaticResource PrimaryButton}"/>
                                        <TextBlock Text="확정된 작업 영역" Style="{StaticResource FieldLabel}"
                                                   FontWeight="SemiBold" Margin="0,12,0,4"/>
                                        <ListBox x:Name="ConfirmedAreasList" MinHeight="46" MaxHeight="130"
                                                 BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                 SelectionChanged="ConfirmedAreasList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="12" Height="12" CornerRadius="2" Margin="0,0,7,0"
                                                                VerticalAlignment="Center" Background="{Binding Swatch}"/>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button x:Name="ClearConfirmedAreaButton" Content="선택 영역 삭제"
                                                Click="DeleteSelectedArea_Click" Style="{StaticResource FlatButton}"
                                                Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <!-- 2. 패턴 생성 -->
                        <TabItem Header="패턴" Style="{StaticResource SidebarTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="4,8,10,12">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="배치 방향" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="DirectionBox" SelectedIndex="0"
                                                          SelectionChanged="DirectionBox_SelectionChanged">
                                                    <ComboBoxItem Content="자동 (장축)"/>
                                                    <ComboBoxItem Content="가로 (Frame X)"/>
                                                    <ComboBoxItem Content="세로 (Frame Y)"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="인출면 · 시작/종료점" Style="{StaticResource FieldLabel}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="PickExitFaceButton" Content="인출면 선택"
                                                            Click="PickExitFace_Click" Padding="10,3"/>
                                                    <Button x:Name="ClearExitFaceButton" Content="초기화"
                                                            Click="ClearExitFace_Click" Padding="10,3" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="ExitFaceStatusText" Text="인출면 미지정 — 인출면 선택 후 외곽선에 강조된 인출 측면을 클릭하세요"
                                                   Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock Text="시작/종료점 후보" Style="{StaticResource FieldLabel}"
                                                   FontWeight="SemiBold" Margin="0,8,0,2"/>
                                        <ListBox x:Name="AnchorCandidateList" MinHeight="26" MaxHeight="120"
                                                 BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                 Background="White"
                                                 SelectionChanged="AnchorCandidateList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="마진 (mm)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="MarginBox" Text="5" Style="{StaticResource ValueBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="간격 (mm)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="SpacingBox" Text="50" Style="{StaticResource ValueBox}"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="삽입 깊이" Style="{StaticResource FieldLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="InsertionDepthBox" Text="0" Width="60"
                                                     IsReadOnly="True" IsTabStop="False" Style="{StaticResource ValueBox}"
                                                     Background="#F3F4F6" Foreground="{StaticResource TextSecondaryBrush}"
                                                     ToolTip="현재 작업 방향 기하 검증은 깊이 0만 지원합니다. 기존 깊이 이동 알고리즘은 마이그레이션 대기 중입니다."/>
                                            <TextBlock Text="mm · 깊이 0만 지원" Style="{StaticResource Hint}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="GenerateButton" Content="패턴 생성" Click="Generate_Click"
                                                Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="GenerateHintText" Text="작업 영역을 확정해야 생성할 수 있습니다."
                                                   Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <!-- 3. 회로·경로 편집 -->
                        <TabItem Header="편집" Style="{StaticResource SidebarTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="4,8,10,12">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <CheckBox x:Name="ConnectorEditModeBox" Content="회로 분할"
                                                  Checked="ConnectorEditMode_Changed"
                                                  Unchecked="ConnectorEditMode_Changed"/>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="연결 구간을 클릭해 회로를 분할하거나 다시 연결합니다. 회로별 길이는 결과 탭에 반영됩니다."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Undo" Click="ConnectorUndo_Click"
                                                    Style="{StaticResource CompactButton}" Margin="0,0,6,0"/>
                                            <Button Content="Redo" Click="ConnectorRedo_Click"
                                                    Style="{StaticResource CompactButton}"/>
                                        </StackPanel>
                                        <Separator Margin="0,10,0,8"/>
                                        <TextBlock Text="전원 연결" Style="{StaticResource FieldLabel}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PowerMigrationHint" Style="{StaticResource Hint}"
                                                   Text="전원 연결 설정은 경로 마이그레이션 완료 후 활성화됩니다 (현재 비활성)."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="PowerSetupButton" Content="전원 연결 위치 지정"
                                                    Click="PowerSetup_Click" Style="{StaticResource CompactButton}"
                                                    Margin="0,0,6,0"/>
                                            <Button x:Name="PowerCancelButton" Content="전원 설정 취소"
                                                    Click="PowerCancel_Click" Style="{StaticResource CompactButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <!-- 4. 결과 -->
                        <TabItem Header="결과" Style="{StaticResource SidebarTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="4,8,10,12">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="회로별 길이 (mm)" Style="{StaticResource FieldLabel}"
                                                   FontWeight="SemiBold"/>
                                        <DataGrid x:Name="CircuitLengthGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                                  Height="150" HeadersVisibility="Column" RowHeaderWidth="0"
                                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDEFF2"
                                                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                  Background="White" RowBackground="White"
                                                  AlternatingRowBackground="#FAFBFC">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="회로" Binding="{Binding Circuit}" Width="*"/>
                                                <DataGridTextColumn Header="발열사" Binding="{Binding HeatingLength, StringFormat=F1}" Width="*"/>
                                                <DataGridTextColumn Header="접속" Binding="{Binding LeadLength, StringFormat=F1}" Width="*"/>
                                                <DataGridTextColumn Header="합계" Binding="{Binding TotalLength, StringFormat=F1}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Content="DXF 투상도 내보내기" Click="Export_Click"
                                                Style="{StaticResource FlatButton}" Margin="0,10,0,0"/>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="금형 4면 투상도(+히든선)와 전기 사양표를 output\heat_pattern.dxf로 저장합니다. 발열 경로는 아직 포함되지 않습니다."/>

                                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12,0,10"/>
                                        <TextBlock Text="전기 사양" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="발열사 프리셋" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                                        <ComboBox x:Name="WirePresetBox" Height="28" SelectedIndex="0"
                                                  SelectionChanged="WirePreset_Changed">
                                            <ComboBoxItem Content="Case 1 — SUS 316L, Ø0.3 mm, 4 Ω/m"/>
                                            <ComboBoxItem Content="Case 2 — SUS 316L, Ø0.15 mm, 8 Ω/m"/>
                                            <ComboBoxItem Content="직접 입력"/>
                                        </ComboBox>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="직경 (mm)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="WireDiameterBox" Text="0.3" Style="{StaticResource ValueBox}"
                                                         TextChanged="ElectricalInput_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Text="단위 저항 (Ω/m)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="WireResistanceBox" Text="4" Style="{StaticResource ValueBox}"
                                                         TextChanged="ElectricalInput_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                                <TextBlock Text="인가전압 (V)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="AppliedVoltageBox" Text="220" Style="{StaticResource ValueBox}"
                                                         TextChanged="ElectricalInput_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                                <TextBlock Text="허용 전류 (A)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="MaxCurrentBox" Text="16" Style="{StaticResource ValueBox}"
                                                         TextChanged="ElectricalInput_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
                                                <TextBlock Text="허용 전력 (W)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="MaxPowerBox" Text="3520" Style="{StaticResource ValueBox}"
                                                         TextChanged="ElectricalInput_Changed"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,26,0,0"
                                                       Style="{StaticResource Hint}"
                                                       Text="합계는 모든 회로가 하나의 전원을 공유한다고 가정합니다."/>
                                        </Grid>
                                        <TextBlock x:Name="ElectricalSummaryText" Style="{StaticResource Hint}"
                                                   Margin="0,8,0,4" Text="생성된 발열 경로가 없습니다"/>
                                        <DataGrid x:Name="ElectricalSpecGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                                  Height="170" HeadersVisibility="Column" RowHeaderWidth="0"
                                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDEFF2"
                                                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                  Background="White" RowBackground="White"
                                                  AlternatingRowBackground="#FAFBFC" FontSize="11"
                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="회로" Binding="{Binding CircuitId}" Width="*" MinWidth="38"/>
                                                <DataGridTextColumn Header="길이 m" Binding="{Binding LengthM, StringFormat=F2}" Width="*" MinWidth="44"/>
                                                <DataGridTextColumn Header="저항 Ω" Binding="{Binding ResistanceOhm, StringFormat=F2}" Width="*" MinWidth="44"/>
                                                <DataGridTextColumn Header="전류 A" Binding="{Binding CurrentA, StringFormat=F2}" Width="*" MinWidth="44"/>
                                                <DataGridTextColumn Header="전력 W" Binding="{Binding PowerW, StringFormat=F1}" Width="*" MinWidth="46"/>
                                                <DataGridTextColumn Header="판정" Binding="{Binding VerdictShortText}" Width="Auto" MinWidth="38"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="L은 가열부 길이(인출부 제외)이며 외부 리드 저항은 반영하지 않습니다. P = V²/(rL), R = rL, I = V/R (RMS, 상온 일정 저항)."/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
