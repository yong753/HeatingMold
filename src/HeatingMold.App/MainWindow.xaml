<Window x:Class="HeatingMold.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HeatingMold.App"
        Title="HeatingMold MVP — S3 통합 데모"
        Height="800" Width="1200" Left="40" Top="40" WindowStartupLocation="Manual">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <TextBlock Text="작업 방향 N:" VerticalAlignment="Center"/>
                <ComboBox x:Name="WorkingAxisBox" Width="65" SelectedIndex="4" SelectionChanged="WorkingAxis_Changed">
                    <ComboBoxItem Content="+X"/><ComboBoxItem Content="−X"/>
                    <ComboBoxItem Content="+Y"/><ComboBoxItem Content="−Y"/>
                    <ComboBoxItem Content="+Z"/><ComboBoxItem Content="−Z"/>
                </ComboBox>
                <Button Content="작업 정면" Click="WorkingFront_Click"/>
            </ToolBar>
            <ToolBar>
                <Button Content="열기..." Click="Open_Click" Padding="8,2"/>
                <Separator/>
                <Button Content="Fit" Click="Fit_Click" Padding="8,2"/>
                <Button Content="줌 +" Click="ZoomIn_Click" Padding="8,2"/>
                <Button Content="줌 −" Click="ZoomOut_Click" Padding="8,2"/>
                <Separator/>
            </ToolBar>
            <ToolBar>
                <TextBlock Text="면:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <ComboBox x:Name="FaceCombo" Width="160"/>
                <Separator/>
                <TextBlock Text="마진:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox x:Name="MarginBox" Text="5" Width="44"/>
                <TextBlock Text="간격:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox x:Name="SpacingBox" Text="10" Width="44"/>
                <TextBlock Text="선폭:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox x:Name="WidthBox" Text="1" Width="44"/>
                <TextBlock Text="삽입 깊이 (보류):" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox x:Name="InsertionDepthBox" Text="0" Width="48" ToolTip="현재 작업 방향 기하 검증은 깊이 0만 지원. 기존 깊이 이동 알고리즘은 마이그레이션 대기 중입니다."/>
                <Separator/>
                <Button Content="패턴 생성" Click="Generate_Click" Padding="8,2"/>
                <CheckBox x:Name="ConnectorEditModeBox" Content="커넥터 편집" Margin="8,0" VerticalAlignment="Center"
                          Checked="ConnectorEditMode_Changed" Unchecked="ConnectorEditMode_Changed"/>
                <Button Content="Undo" Click="ConnectorUndo_Click" Padding="6,2"/>
                <Button Content="Redo" Click="ConnectorRedo_Click" Padding="6,2"/>
                <Button Content="전원 연결 위치 지정" Click="PowerSetup_Click" Padding="6,2"/>
                <Button Content="전원 설정 취소" Click="PowerCancel_Click" Padding="6,2"/>
                <Button Content="DXF 내보내기" Click="Export_Click" Padding="8,2"/>
                <Separator/>
                <Button Content="정면 (−Z)" Click="StandardView_Click" Tag="Front" Padding="6,2"/>
                <Button Content="후면 (+Z)" Click="StandardView_Click" Tag="Back" Padding="6,2"/>
                <Button Content="위쪽 (−Y)" Click="StandardView_Click" Tag="Top" Padding="6,2"/>
                <Button Content="아래쪽 (+Y)" Click="StandardView_Click" Tag="Bottom" Padding="6,2"/>
                <Button Content="좌측 (−X)" Click="StandardView_Click" Tag="Left" Padding="6,2"/>
                <Button Content="우측 (+X)" Click="StandardView_Click" Tag="Right" Padding="6,2"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="HoverText" Text="" MinWidth="170" Foreground="#0A6A2F"/>
            <Separator/>
            <TextBlock x:Name="StatusText" Text="준비"/>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <local:OccViewport x:Name="Viewport" Grid.Column="0"/>
            <Border Grid.Column="1" BorderBrush="#808080" BorderThickness="1,0,0,0" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="WorkingSideText" Text="작업 방향 미확정 · 패턴 생성 보류" TextWrapping="Wrap"/>
                    <TextBlock Text="적용 Face" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="클릭/Ctrl+클릭 또는 Shift+드래그로 Face 선택 · Enter로 작업영역 확정" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ListBox x:Name="SelectedFacesList" MinHeight="120" MaxHeight="260"/>
                    <Button Content="확정 영역 삭제" Click="ClearConfirmedArea_Click" Margin="0,5,0,0" Padding="6,3"/>
                    <Separator Margin="0,10,0,8"/>
                    <TextBlock Text="제외 영역" FontWeight="Bold"/>
                    <CheckBox x:Name="ExcludeModeBox" Content="뷰포트에서 사각형 제외영역 그리기" Margin="0,5,0,5"
                              Checked="ExcludeMode_Changed" Unchecked="ExcludeMode_Changed"/>
                    <TextBlock Text="선택된 동일 평면 Face 위에서 드래그하세요. 아래는 2D 확인용입니다."
                               TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"/>
                    <Border BorderBrush="#808080" BorderThickness="1" Background="White" HorizontalAlignment="Stretch" Height="200">
                        <Canvas x:Name="RegionCanvas" Background="Transparent" SizeChanged="RegionCanvas_SizeChanged"/>
                    </Border>
                    <Button Content="제외 사각형 초기화" Click="ClearExclusions_Click" Margin="0,5,0,0" Padding="6,3"/>
                    <TextBlock Text="회로별 길이 (mm)" FontWeight="Bold" Margin="0,10,0,4"/>
                    <DataGrid x:Name="CircuitLengthGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="140">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="회로" Binding="{Binding Circuit}" Width="*"/>
                            <DataGridTextColumn Header="발열사" Binding="{Binding HeatingLength, StringFormat=F1}" Width="*"/>
                            <DataGridTextColumn Header="접속" Binding="{Binding LeadLength, StringFormat=F1}" Width="*"/>
                            <DataGridTextColumn Header="합계" Binding="{Binding TotalLength, StringFormat=F1}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
