<Window x:Class="HeatingMold.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HeatingMold.App"
        Title="HeatingMold MVP — S3 통합 데모"
        Height="800" Width="1200" Left="40" Top="40" WindowStartupLocation="Manual">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <TextBlock Text="작업축 N:" VerticalAlignment="Center"/>
                <ComboBox x:Name="WorkingAxisBox" Width="65"
                          SelectedIndex="{Binding WorkingCoordinates.SelectedAxisIndex, Mode=TwoWay}"
                          SelectionChanged="WorkingAxis_Changed">
                    <ComboBoxItem Content="+X"/><ComboBoxItem Content="−X"/>
                    <ComboBoxItem Content="+Y"/><ComboBoxItem Content="−Y"/>
                    <ComboBoxItem Content="+Z"/><ComboBoxItem Content="−Z"/>
                </ComboBox>
                <Button Content="작업 정면" Click="WorkingFront_Click"/>
            </ToolBar>
            <ToolBar>
                <Button Content="STEP 열기..." Click="Open_Click" Padding="8,2"/>
                <Button Content="프로젝트 열기..." Click="OpenProject_Click" Padding="8,2"/>
                <Button Content="프로젝트 저장..." Click="SaveProject_Click" Padding="8,2"/>
                <Separator/>
                <Button Content="Fit" Click="Fit_Click" Padding="8,2"/>
                <Button Content="줌 +" Click="ZoomIn_Click" Padding="8,2"/>
                <Button Content="줌 −" Click="ZoomOut_Click" Padding="8,2"/>
                <Separator/>
            </ToolBar>
            <ToolBar>
                <TextBlock Text="면:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <ComboBox x:Name="FaceCombo" Width="160"/>
                <Separator/>
                <TextBlock Text="경계 여유(mm):" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox Width="48"
                         Text="{Binding PlacementParameters.BoundaryMarginText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="최소 외곽 간격 g(mm):" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox Width="48" ToolTip="발열사 바깥면 사이에 확보할 최소 간격입니다."
                         Text="{Binding PlacementParameters.MinimumClearGapText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="직경 d(mm):" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox Width="48" ToolTip="발열 도체의 실제 지름입니다."
                         Text="{Binding WireSpecification.DiameterText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="중심 피치 p=g+d(mm):" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBlock Text="{Binding PlacementParameters.CenterPitchText}"
                           MinWidth="44" VerticalAlignment="Center"/>
                <TextBlock Text="삽입 깊이:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox Width="48" ToolTip="금형 표면에서 작업축 방향 발열사 바깥면까지의 거리 D(mm)입니다."
                         Text="{Binding PlacementParameters.InsertionDepthText, UpdateSourceTrigger=PropertyChanged}"/>
                <Separator/>
                <Button Content="패턴 생성" Click="Generate_Click" Padding="8,2"/>
                <CheckBox x:Name="CircuitSplitModeBox" Content="회로 topology 미리보기" Margin ="8,0" VerticalAlignment="Center"
                          Checked="CircuitSplitMode_Changed" Unchecked="CircuitSplitMode_Changed"/>
                <Button Content="DXF 내보내기" Click="Export_Click" Padding="8,2"/>
                <Separator/>
                <Button Content="정면 (−Z)" Click="StandardView_Click" Tag="Front" Padding="6,2"/>
                <Button Content="후면 (+Z)" Click="StandardView_Click" Tag="Back" Padding="6,2"/>
                <Button Content="위쪽 (−Y)" Click="StandardView_Click" Tag="Top" Padding="6,2"/>
                <Button Content="아래쪽 (+Y)" Click="StandardView_Click" Tag="Bottom" Padding="6,2"/>
                <Button Content="좌측 (−X)" Click="StandardView_Click" Tag="Left" Padding="6,2"/>
                <Button Content="우측 (+X)" Click="StandardView_Click" Tag="Right" Padding="6,2"/>
            </ToolBar>
            <ToolBar>
                <Button Content="설계 DXF 저장..." Click="ExportDesignDxf_Click" Padding="8,2"/>
                <Button Content="설계 STEP 저장..." Click="ExportDesignStep_Click" Padding="8,2"/>
                <CheckBox x:Name="IncludeSourceModelInStepBox" Content="STEP에 원본 모델 포함"
                          ToolTip="선택하면 저장된 원본 STEP의 몰드 형상도 설계 STEP에 포함합니다."
                          Margin="8,0" VerticalAlignment="Center"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="HoverText" Text="" MinWidth="170" Foreground="#0A6A2F"/>
            <Separator/>
            <TextBlock x:Name="StatusText" Text="준비"/>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <local:OccViewport x:Name="Viewport" Grid.Column="0"/>
            <Border Grid.Column="1" BorderBrush="#808080" BorderThickness="1,0,0,0" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="WorkingCoordinateSystemText" Text="{Binding WorkingCoordinates.DisplayStatus}" TextWrapping="Wrap"/>
                    <Separator Margin="0,8,0,6"/>
                    <TextBlock Text="경로 생성 입력" FontWeight="Bold"/>
                    <TextBlock Text="확정할 발열 영역" Margin="0,5,0,2"/>
                    <ComboBox x:Name="HeatingRegionCombo" DisplayMemberPath="DisplayName"
                              SelectionChanged="HeatingRegion_SelectionChanged"/>
                    <TextBlock Text="작업 화면을 클릭해 표면 앵커를 지정하세요." TextWrapping="Wrap"
                               FontSize="11" Margin="0,5,0,4"/>
                    <Button Content="발열 경로 시작 앵커 지정" Click="PickHeatingStartAnchor_Click" Margin="0,2"/>
                    <TextBlock Text="{Binding PathAnchors.HeatingStartStatusText}"
                               TextWrapping="Wrap" FontSize="11"/>
                    <Button Content="발열 경로 끝 앵커 지정" Click="PickHeatingEndAnchor_Click" Margin="0,2"/>
                    <TextBlock Text="{Binding PathAnchors.HeatingEndStatusText}"
                               TextWrapping="Wrap" FontSize="11"/>
                    <Button Content="시작부 금형 인출 앵커 지정" Click="PickStartMoldExitAnchor_Click" Margin="0,2"/>
                    <TextBlock Text="{Binding PathAnchors.StartMoldExitStatusText}"
                               TextWrapping="Wrap" FontSize="11"/>
                    <Button Content="끝부 금형 인출 앵커 지정" Click="PickEndMoldExitAnchor_Click" Margin="0,2"/>
                    <TextBlock Text="{Binding PathAnchors.EndMoldExitStatusText}"
                               TextWrapping="Wrap" FontSize="11"/>
                    <Button Content="앵커 지정 취소" Click="CancelSurfaceAnchorPick_Click" Margin="0,2"/>
                    <TextBlock Text="발열선 사양" FontWeight="Bold" Margin="0,8,0,3"/>
                    <TextBlock Text="재료명" FontSize="11"/>
                    <TextBox
                             Text="{Binding WireSpecification.MaterialText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="단위 길이당 저항 (Ω/m)" FontSize="11"/>
                    <TextBox
                             Text="{Binding WireSpecification.ResistanceText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="배치 방향" FontSize="11" Margin="0,4,0,0"/>
                    <ComboBox x:Name="PlacementDirectionBox" SelectedIndex="0">
                        <ComboBoxItem Content="작업 X 방향" Tag="AlongX"/>
                        <ComboBoxItem Content="작업 Y 방향" Tag="AlongY"/>
                    </ComboBox>
                    <TextBlock Text="기존 수동 편집 경로 처리" FontSize="11" Margin="0,4,0,0"/>
                    <ComboBox x:Name="ManualEditPolicyBox" SelectedIndex="0">
                        <ComboBoxItem Content="호환되는 편집 보존" Tag="PreserveIfCompatible"/>
                        <ComboBoxItem Content="편집 경로 교체" Tag="ReplaceEditedHeatingPath"/>
                    </ComboBox>
                    <TextBlock Text="시작부 외부 연결 좌표 (X, Y, Z mm)" FontSize="11" Margin="0,8,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="68" ToolTip="X (mm)"
                                 Text="{Binding HeatingPathCircuitInputs.StartExternalXText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="68" Margin="3,0" ToolTip="Y (mm)"
                                 Text="{Binding HeatingPathCircuitInputs.StartExternalYText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="68" ToolTip="Z (mm)"
                                 Text="{Binding HeatingPathCircuitInputs.StartExternalZText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <TextBlock Text="끝부 외부 연결 좌표 (X, Y, Z mm)" FontSize="11" Margin="0,6,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="68" ToolTip="X (mm)"
                                 Text="{Binding HeatingPathCircuitInputs.EndExternalXText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="68" Margin="3,0" ToolTip="Y (mm)"
                                 Text="{Binding HeatingPathCircuitInputs.EndExternalYText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Width="68" ToolTip="Z (mm)"
                                 Text="{Binding HeatingPathCircuitInputs.EndExternalZText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <TextBlock Text="연결부 추가 여유 (mm, 구간별)" FontWeight="Bold" Margin="0,8,0,2"/>
                    <TextBlock Text="금형 위 연장 구간" FontSize="11"/>
                    <TextBox Text="{Binding HeatingPathCircuitInputs.MoldExitAllowanceText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="외부 연결선 구간" FontSize="11"/>
                    <TextBox Text="{Binding HeatingPathCircuitInputs.ExternalConnectionAllowanceText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="전원 사양 (비워 두면 해당 한도 없음)" FontWeight="Bold" Margin="0,8,0,2"/>
                    <TextBlock Text="실제 전압 (V RMS)" FontSize="11"/>
                    <TextBox Text="{Binding HeatingPathCircuitInputs.ActualVoltageText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="최대 전압 (V RMS)" FontSize="11"/>
                    <TextBox Text="{Binding HeatingPathCircuitInputs.MaximumVoltageText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="최대 전류 (A)" FontSize="11"/>
                    <TextBox Text="{Binding HeatingPathCircuitInputs.MaximumCurrentText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="최대 전력 (W)" FontSize="11"/>
                    <TextBox Text="{Binding HeatingPathCircuitInputs.MaximumPowerText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="발열 영역에 포함할 면" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="뷰포트 클릭으로 선택, Ctrl+클릭으로 토글" TextWrapping="Wrap" Margin ="0,0,0,6"/>
                    <CheckBox x:Name="FaceDragSelectModeBox" Content="드래그로 Face 선택 모드" Margin ="0,4,0,4"
                              Checked="FaceDragSelectMode_Changed" Unchecked="FaceDragSelectMode_Changed"/>
                    <ListBox x:Name="SelectedFacesList" MinHeight="120" MaxHeight="260"/>
                    <Separator Margin ="0,10,0,8"/>
                    <TextBlock Text="제외 영역" FontWeight="Bold"/>
                    <CheckBox x:Name="IncludeModeBox" Content="뷰포트에서 포함 사각형 그리기" Margin ="0,5,0,2"
                              Checked="IncludeMode_Changed" Unchecked="IncludeMode_Changed"/>
                    <CheckBox x:Name="ExcludeModeBox" Content="뷰포트에서 사각형 제외영역 그리기" Margin ="0,5,0,5"
                              Checked="ExcludeMode_Changed" Unchecked="ExcludeMode_Changed"/>
                    <TextBlock Text="확정한 발열 영역 위에서 드래그하면 포함·제외 사각형을 프로젝트에 저장합니다. 아래는 유효 경계입니다."
                               TextWrapping="Wrap" FontSize="11" Margin ="0,0,0,4"/>
                    <Border BorderBrush="#808080" BorderThickness="1" Background="White" HorizontalAlignment="Stretch" Height="200">
                        <Canvas x:Name="RegionCanvas" Background="Transparent" SizeChanged="RegionCanvas_SizeChanged"/>
                    </Border>
                    <TextBlock Text="공통 인출 측면 · 같은 경계의 이어진 구간을 선택하세요"
                               FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                    <ListBox x:Name="ExitSideSegmentsList" SelectionMode="Extended"
                             DisplayMemberPath="DisplayName" MinHeight="90" MaxHeight="180"/>
                    <Button Content="선택 영역 확정" Click="CommitSelectedRegion_Click"
                            Margin="0,5,0,0" Padding="6,3"/>
                    <Button Content="확정 영역 제외부 초기화" Click="ClearExclusions_Click" Margin ="0,5,0,0" Padding="6,3"/>
                    <TextBlock Text="회로별 발열사·연결 경로 길이 (mm)" FontWeight="Bold" Margin="0,10,0,4"/>
                    <DataGrid x:Name="CircuitLengthGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="140">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="회로" Binding="{Binding Circuit}" Width="*"/>
                            <DataGridTextColumn Header="발열사" Binding="{Binding HeatingLength, StringFormat=F1}" Width="*"/>
                            <DataGridTextColumn Header="연결" Binding="{Binding ConnectionLength, StringFormat=F1}" Width="*"/>
                            <DataGridTextColumn Header="합계" Binding="{Binding TotalLength, StringFormat=F1}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="전기 계산 · 회로별" FontWeight="Bold" Margin="0,10,0,3"/>
                    <TextBlock x:Name="ElectricalResultsStatusText" Text="확정 설계의 전기 계산 결과가 없습니다."
                               TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3"/>
                    <ItemsControl x:Name="ElectricalResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="2,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CircuitLabel}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#6B7280"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Pass">
                                                            <Setter Property="Foreground" Value="#167A37"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="LimitExceeded">
                                                            <Setter Property="Foreground" Value="#B42318"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Incomplete">
                                                            <Setter Property="Foreground" Value="#9A6700"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="InvalidInput">
                                                            <Setter Property="Foreground" Value="#B42318"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Stale">
                                                            <Setter Property="Foreground" Value="#9A6700"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding LengthAndResistance}" FontSize="11"/>
                                        <TextBlock Text="{Binding LengthBreakdownDetails}" TextWrapping="Wrap"
                                                   FontSize="10" Foreground="#555555"/>
                                        <TextBlock Text="{Binding VoltageAndLimit}" FontSize="11"/>
                                        <TextBlock Text="{Binding CurrentAndLimit}" FontSize="11"/>
                                        <TextBlock Text="{Binding PowerAndLimit}" FontSize="11"/>
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="10"
                                                   Foreground="#555555"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="전기 사양 수정 · 회로별 전원" FontWeight="Bold" Margin="0,8,0,3"/>
                    <TextBlock Text="위 발열선 재료명·Ω/m을 사용합니다. 선경은 경로 형상에 영향을 주므로 여기서 바꾸지 않습니다." TextWrapping="Wrap" FontSize="10"/>
                    <DataGrid ItemsSource="{Binding ElectricalSpecification.CircuitSupplies}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              MinHeight="90" MaxHeight="180" Margin="0,3,0,2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="회로" Binding="{Binding CircuitLabel}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="실제 V" Binding="{Binding ActualVoltage, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="최대 V" Binding="{Binding MaximumVoltage, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="최대 A" Binding="{Binding MaximumCurrent, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="최대 W" Binding="{Binding MaximumPower, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Content="전기 입력 초안" Command="{Binding ElectricalSpecification.CreateDraftCommand}" Padding="6,3"/>
                        <Button Content="전기 사양 적용" Command="{Binding ElectricalSpecification.ApplyDraftCommand}" Margin="4,0,0,0" Padding="6,3"/>
                        <Button Content="초안 취소" Command="{Binding ElectricalSpecification.CancelDraftCommand}" Margin="4,0,0,0" Padding="6,3"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ElectricalSpecification.StatusText}"
                               TextWrapping="Wrap" FontSize="10" Margin="0,3,0,2"/>
                    <TextBlock Text="적용면적 · 실측 분할 집계" FontWeight="Bold" Margin="0,10,0,3"/>
                    <TextBlock x:Name="AppliedAreaStatusText" Text="적용면적 분할은 아직 계산되지 않았습니다."
                               TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3"/>
                    <TextBlock x:Name="AppliedAreaSummaryText" TextWrapping="Wrap" FontSize="11"/>
                    <ItemsControl x:Name="CircuitAppliedAreasList" Margin="0,3,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="간격·표면 커버리지 관측" FontWeight="Bold" Margin="0,10,0,3"/>
                    <TextBlock x:Name="CenterPitchQualityStatusText"
                               Text="확정 설계의 간격·표면 커버리지 관측 결과가 없습니다."
                               TextWrapping="Wrap" FontSize="10" Margin="0,0,0,3"/>
                    <ItemsControl x:Name="CenterPitchQualityList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="2,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RegionLabel}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CoverageSummary}" TextWrapping="Wrap" FontSize="10"/>
                                        <Button Content="{Binding CoverageLocation}"
                                                Tag="{Binding CoverageLocationSelection}"
                                                IsEnabled="{Binding CanShowCoverageLocation}"
                                                Click="QualityLocation_Click"
                                                HorizontalContentAlignment="Left"
                                                Padding="2,1" Margin="0,1"
                                                FontSize="10"/>
                                        <ItemsControl ItemsSource="{Binding LanePitchRows}" Margin="0,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Text}"
                                                            Tag="{Binding Selection}"
                                                            IsEnabled="{Binding CanShowLocation}"
                                                            Click="QualityLocation_Click"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="2,1" Margin="4,1,0,1"
                                                            FontSize="10" Foreground="#555555"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="회전 구간 활성 상태 · 체크 해제 시 경로를 나눕니다"
                               FontSize="11" Margin="0,6,0,2"/>
                    <ListBox x:Name="CircuitTurnSegmentsList" IsEnabled="False" MaxHeight="110"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          Click="CircuitTurnChoice_Click"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="통합 시 유지할 회로" FontSize="11" Margin="0,6,0,2"/>
                    <ComboBox x:Name="CircuitSurvivorCombo" DisplayMemberPath="DisplayName"
                              SelectionChanged="CircuitSurvivor_SelectionChanged"/>
                    <TextBlock Text="새 회로 연결부" FontSize="11" FontWeight="Bold" Margin="0,6,0,2"/>
                    <ComboBox x:Name="CircuitTopologyEndpointCombo" DisplayMemberPath="DisplayName"
                              IsEnabled="False" SelectionChanged="CircuitTopologyEndpoint_SelectionChanged"/>
                    <Button Content="선택 끝점 표면 위치 지정" Click="PickCircuitTopologyEndpointAnchor_Click"
                            Margin="0,3,0,2" Padding="6,3"/>
                    <TextBlock x:Name="CircuitTopologyEndpointStatusText" Text="신규 연결부 입력: 필요 없음"
                               TextWrapping="Wrap" FontSize="11"/>
                    <TextBlock Text="외부 연결 좌표 (X, Y, Z mm)" FontSize="11" Margin="0,4,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TopologyEndpointXBox" Width="68" ToolTip="X (mm)"/>
                        <TextBox x:Name="TopologyEndpointYBox" Width="68" Margin="3,0" ToolTip="Y (mm)"/>
                        <TextBox x:Name="TopologyEndpointZBox" Width="68" ToolTip="Z (mm)"/>
                    </StackPanel>
                    <Button Content="선택 끝점 외부 좌표 저장" Click="SaveCircuitTopologyEndpointCoordinates_Click"
                            Margin="0,3,0,2" Padding="6,3"/>
                    <TextBlock Text="새 연결 경로 추가 여유 (mm)" FontSize="11" FontWeight="Bold" Margin="0,4,0,2"/>
                    <TextBlock Text="금형 위 연장 구간" FontSize="11"/>
                    <TextBox x:Name="TopologyMoldExitAllowanceBox" Text="0"/>
                    <TextBlock Text="외부 연결선 구간" FontSize="11"/>
                    <TextBox x:Name="TopologyExternalAllowanceBox" Text="0"/>
                    <TextBlock x:Name="CircuitTopologyPreviewText" Text="미리보기: 없음"
                               TextWrapping="Wrap" FontSize="11" Margin="0,4,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="회로 구성 적용" Click="ApplyCircuitTopology_Click" Padding="6,3"/>
                        <Button Content="미리보기 취소" Click="CancelCircuitTopology_Click" Margin="5,0,0,0" Padding="6,3"/>
                    </StackPanel>
                    <Separator Margin="0,10,0,8"/>
                    <TextBlock Text="제어점 편집" FontWeight="Bold"/>
                    <TextBlock Text="안정 ID로 내부 절점을 선택하고, 뷰포트에서 새 표면 위치를 지정하세요. 회로 끝점과 미지원 곡선은 목록에서 제외됩니다."
                               TextWrapping="Wrap" FontSize="11" Margin="0,3,0,4"/>
                    <ComboBox x:Name="ControlPointCombo" DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding ControlPoints.Choices}"
                              SelectedItem="{Binding ControlPoints.SelectedChoice, Mode=TwoWay}"
                              SelectionChanged="ControlPoint_SelectionChanged"/>
                    <Button Content="새 표면 위치 선택" Click="PickControlPointAnchor_Click" Margin="0,4,0,2"/>
                    <Button Content="제어점 드래그 편집" Click="BeginControlPointDrag_Click" Margin="0,2"/>
                    <TextBlock x:Name="ControlPointAnchorStatusText" Text="새 위치: 미지정"
                               TextWrapping="Wrap" FontSize="11"/>
                    <TextBlock Text="원호 끝점 허용 오차 (mm)" FontSize="11" Margin="0,5,0,0"/>
                    <TextBox x:Name="ControlPointToleranceBox" Text="0.05"/>
                    <Button Content="제어점 이동 확정" Click="MoveControlPoint_Click"
                            Margin="0,4,0,0" Padding="6,3"/>
                    <Separator Margin="0,10,0,8"/>
                    <TextBlock Text="회전 구간 내부 곡선 편집" FontWeight="Bold"/>
                    <TextBlock Text="활성 회전 구간의 내부 다중선 점만 수정합니다. 양 끝점은 공유 절점에 고정되며, 적용 시 전체 기하 검증을 다시 수행합니다."
                               TextWrapping="Wrap" FontSize="11" Margin="0,3,0,4"/>
                    <ComboBox x:Name="TurnSegmentCurveCombo" DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding TurnSegmentCurves.Choices}"
                              SelectedItem="{Binding TurnSegmentCurves.SelectedChoice, Mode=TwoWay}"
                              SelectionChanged="TurnSegmentCurve_SelectionChanged"/>
                    <DataGrid x:Name="TurnSegmentInteriorPointsGrid"
                              ItemsSource="{Binding TurnSegmentCurves.InteriorPoints}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column"
                              Height="120" Margin="0,4,0,2"
                              CellEditEnding="TurnSegmentInteriorPoint_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="점" Binding="{Binding PointNumber}"
                                                IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="X (mm)" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Z (mm)" Binding="{Binding Z, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="미리보기" Click="PreviewTurnSegmentCurve_Click" Padding="6,3"/>
                        <Button Content="적용" Click="ApplyTurnSegmentCurve_Click" Margin="4,0,0,0" Padding="6,3"/>
                        <Button Content="미리보기 취소" Click="CancelTurnSegmentCurve_Click" Margin="4,0,0,0" Padding="6,3"/>
                    </StackPanel>
                    <TextBlock x:Name="TurnSegmentCurveEditorStatusText" Text="편집할 활성 회전 구간을 선택하세요."
                               TextWrapping="Wrap" FontSize="11" Margin="0,4,0,2"/>
                    <Separator Margin="0,10,0,8"/>
                    <TextBlock Text="연결 경로 편집" FontWeight="Bold"/>
                    <TextBlock Text="안정 연결부를 선택하고 구간 끝점·도메인·재료·여유를 수정합니다. 적용할 때 전체 모델 장애물 검사를 다시 수행합니다."
                               TextWrapping="Wrap" FontSize="11" Margin="0,3,0,4"/>
                    <ComboBox x:Name="ConnectionPathEndpointCombo" DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding ConnectionPaths.Choices}"
                              SelectedItem="{Binding ConnectionPaths.SelectedChoice, Mode=TwoWay}"
                              SelectionChanged="ConnectionPathEndpoint_SelectionChanged"/>
                    <DataGrid x:Name="ConnectionPathLegsGrid" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              Height="190" Margin="0,4,0,2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="X (mm)" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Z (mm)" Binding="{Binding Z, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridComboBoxColumn Header="공간" SelectedItemBinding="{Binding GeometryDomain, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridComboBoxColumn Header="재료" SelectedItemBinding="{Binding ConductorRole, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="여유 (mm)" Binding="{Binding AdditionalAllowanceMm, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridCheckBoxColumn Header="이탈" Binding="{Binding IsMoldExitTransition, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="외부 경유점 추가" Click="AddConnectionPathWaypoint_Click" Padding="6,3"/>
                        <Button Content="선택 경유점 제거" Click="RemoveConnectionPathWaypoint_Click" Margin="4,0,0,0" Padding="6,3"/>
                        <Button Content="연결 경로 적용" Click="ApplyConnectionPathEdit_Click" Margin="4,0,0,0" Padding="6,3"/>
                    </StackPanel>
                    <TextBlock x:Name="ConnectionPathEditorStatusText" Text="수정할 연결 경로를 선택하세요."
                               TextWrapping="Wrap" FontSize="11" Margin="0,4,0,2"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
