<Window x:Class="HeatingMold.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HeatingMold.App"
        Title="HeatingMold MVP — S3 통합 데모"
        Height="800" Width="1200" Left="40" Top="40" WindowStartupLocation="Manual">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="열기..." Click="Open_Click" Padding="8,2"/>
                <Separator/>
                <Button Content="Fit" Click="Fit_Click" Padding="8,2"/>
                <Button Content="줌 +" Click="ZoomIn_Click" Padding="8,2"/>
                <Button Content="줌 −" Click="ZoomOut_Click" Padding="8,2"/>
                <Separator/>
                <Button Content="HLR 스모크" Click="Hlr_Click" Padding="8,2"/>
            </ToolBar>
            <ToolBar>
                <TextBlock Text="면:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <ComboBox x:Name="FaceCombo" Width="160"/>
                <Separator/>
                <TextBlock Text="마진:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox x:Name="MarginBox" Text="5" Width="44"/>
                <TextBlock Text="간격:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox x:Name="SpacingBox" Text="10" Width="44"/>
                <TextBlock Text="선폭:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBox x:Name="WidthBox" Text="1" Width="44"/>
                <Separator/>
                <Button Content="패턴 생성" Click="Generate_Click" Padding="8,2"/>
                <Button Content="DXF 내보내기" Click="Export_Click" Padding="8,2"/>
                <Separator/>
                <Button Content="정면 뷰" Click="FrontView_Click" Padding="8,2"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="HoverText" Text="" MinWidth="170" Foreground="#0A6A2F"/>
            <Separator/>
            <TextBlock x:Name="StatusText" Text="준비"/>
        </StatusBar>
        <local:OccViewport x:Name="Viewport"/>
    </DockPanel>
</Window>
