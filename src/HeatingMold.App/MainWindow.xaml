<Window x:Class="HeatingMold.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HeatingMold.App"
        Title="HeatingMold MVP — S1 브리지·뷰어 스파이크"
        Height="760" Width="1100" Left="40" Top="40" WindowStartupLocation="Manual">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="열기..." Click="Open_Click" Padding="8,2"/>
                <Separator/>
                <Button Content="Fit" Click="Fit_Click" Padding="8,2"/>
                <Button Content="줌 +" Click="ZoomIn_Click" Padding="8,2"/>
                <Button Content="줌 −" Click="ZoomOut_Click" Padding="8,2"/>
                <Separator/>
                <Button Content="색상 전환" Click="Color_Click" Padding="8,2"/>
                <Separator/>
                <Button Content="HLR 스모크" Click="Hlr_Click" Padding="8,2"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="준비"/>
        </StatusBar>
        <local:OccViewport x:Name="Viewport"/>
    </DockPanel>
</Window>
