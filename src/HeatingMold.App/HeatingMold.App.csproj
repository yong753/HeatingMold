<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- C++/CLI net8.0 mixed-mode DLL 로드 필수 (1.3 실측) — ijwhost.dll 자동 복사 -->
    <UseIJWHost>true</UseIJWHost>
    <AssemblyName>HeatingMold.App</AssemblyName>
    <RootNamespace>HeatingMold.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 기본 로드 STEP: 솔리드 30개 / 574면 (중복 면 0).
         생성 스크립트: tools/step-cleanup/remove-surface-bodies.ps1 -->
    <Content Include="..\..\resource\Mold_Solids.stp">
      <Link>resource\Mold_Solids.stp</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- OccBridge는 솔루션 빌드 순서(ProjectDependencies)로 먼저 빌드됨 -->
    <Reference Include="OccBridge">
      <HintPath>$(MSBuildThisFileDirectory)..\..\x64\Release\OccBridge.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <ProjectReference Include="..\HeatingMold.Core\HeatingMold.Core.csproj" />
    <ProjectReference Include="..\HeatingMold.Export\HeatingMold.Export.csproj" />
  </ItemGroup>
</Project>
