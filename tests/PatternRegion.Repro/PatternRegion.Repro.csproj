<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app references x64/Release/OccBridge.dll; Run.ps1 builds the native bridge there first. -->
    <Reference Include="OccBridge"><HintPath>../../x64/Release/OccBridge.dll</HintPath></Reference>
    <ProjectReference Include="../../src/HeatingMold.Core/HeatingMold.Core.csproj" />
    <None Include="../../x64/Release/Ijwhost.dll" Link="Ijwhost.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
